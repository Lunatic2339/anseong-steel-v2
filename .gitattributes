# Preserve source/snapshot bytes for provenance hashes.
* -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
# Unity-generated metadata and captured logs keep their original spacing.
*.meta -whitespace
docs/validation/*.log -whitespace
docs/validation/**/*.log -whitespace
# Preserve Unity-authored serialized asset formatting.
*.asset -whitespace
*.unity -whitespace
*.mat -whitespace
